---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    <div class="stripe short" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    background: var(--white);
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(2rem, 5vw, 3rem);
  }
  .page-hero .stripe { margin-block: 1rem 1.25rem; }
  .page-hero .lead { margin-bottom: 0.5rem; }
</style>
