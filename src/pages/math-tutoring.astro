---
import { withBase } from "../lib/url";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
---

<Base
  title="Math Tutoring | Voted BEST Math Tutor | My Learning Studio"
  description="Voted The Best Math Tutor in the Inland Empire. Elementary math through Calculus AB and BC, Integrated Math 1-3, and precalculus. In person in Riverside or online, 7 days a week."
>
  <PageHero
    eyebrow="math tutoring"
    title="Voted BEST Math Tutor"
    lead="From first-grade number sense to college calculus, our instructors teach each student the way they learn best. Whether it's visually, auditorily, or kinesthetically, we've got you covered."
  />

  <section class="section">
    <div class="container two-col">
      <div>
        <h2>Every level of math</h2>
        <ul class="checks">
          <li>Elementary and middle school math</li>
          <li>Integrated Math 1, 2, and 3</li>
          <li>Algebra, geometry, and trigonometry</li>
          <li>Precalculus</li>
          <li>Calculus AB and BC</li>
          <li>College-level mathematics</li>
        </ul>
        <p>
          Our tutors also cover Spanish, biology, chemistry, and reading, so one
          studio can support your student across every subject.
        </p>
        <div class="callout">
          <p>
            <strong>In-person and online virtual tutoring is available 7 days a
            week, 9:00 AM to 9:00 PM.</strong>
          </p>
        </div>
      </div>
      <div class="photo-frame">
        <img src={withBase("/images/student-work.jpg")} alt="Student math work at My Learning Studio" width="1200" height="1600" loading="lazy" />
      </div>
    </div>
  </section>

  <CtaBand
    title="Make math the strong subject"
    text="Named The Best Math Tutor by BEST of the Inland Empire Magazine. Register online or call to get matched with a math tutor."
  />
</Base>
