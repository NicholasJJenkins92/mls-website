---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page Not Found | My Learning Studio"
  description="That page could not be found. Head back to My Learning Studio's homepage."
>
  <section class="section center" style="padding-block: 6rem;">
    <div class="container">
      <span class="eyebrow">oops!</span>
      <h1>We couldn't find that page</h1>
      <div class="stripe short" aria-hidden="true" style="margin-inline: auto; margin-block: 1rem;"><span></span><span></span><span></span><span></span><span></span></div>
      <p class="lead" style="margin-inline: auto;">
        Even the best students take a wrong turn sometimes. Let's get you back
        on track.
      </p>
      <p style="margin-top: 1.5rem;">
        <a class="btn btn-primary" href="/">Back to Home</a>
      </p>
    </div>
  </section>
</Base>
